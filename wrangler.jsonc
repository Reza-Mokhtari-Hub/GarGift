{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gargift-plus",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GARGIFT_STORE",
        "class_name": "GarGiftStoreDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GarGiftStoreDO"]
    }
  ]
}

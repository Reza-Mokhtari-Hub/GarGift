# متغیرهای محیطی گرگیفت+ (GarGift+)

# کلید امضای توکن‌های نشست JWT (حداقل ۳۲ کاراکتر تصادفی)
JWT_SECRET="change_this_to_a_very_secure_32_char_secret_key"

# کلید رمزنگاری کدهای گیفت‌کارت در دیتابیس با الگوریتم AES-256-GCM (۳۲ بایت یا ۶۴ کاراکتر هگز)
CODES_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# اطلاعات مدیرکل اولیه (در اولین اجرای برنامه ساخته می‌شود)
ADMIN_PHONE="09120000000"
ADMIN_EMAIL="admin@gargift.ir"
ADMIN_INITIAL_PASSWORD="Admin@123456"

# آدرس عمومی برنامه
APP_URL="http://localhost:3000"

# تنظیمات درگاه‌های پرداخت (اختیاری - از پنل مدیریت نیز قابل تنظیم است)
ZARINPAL_MERCHANT_ID=""
ZIBAL_MERCHANT_ID="zibal"

# کلید API سرویس پیامک (کاوه‌نگار / ملی‌پیامک / آی‌پی‌پنل)
SMS_API_KEY=""

# کلید Gemini API (در محیط AI Studio خودکار تزریق می‌شود)
GEMINI_API_KEY=""
